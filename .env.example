# Backend
APP_NAME=VisionInspect AI
ENVIRONMENT=development
SECRET_KEY=replace-with-secure-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_URL=http://localhost:8000

# Local MongoDB is the clone-and-run default. Replace this with an Atlas URI when needed.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=visioninspect_ai

# Cloudinary is optional. Empty values use local upload storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_TIMEOUT_SECONDS=20
USE_CLOUDINARY_STORAGE=false

# Portable inference is enabled by default. Advanced checkpoints are optional.
USE_PADIM_INFERENCE=false
USE_OPENVINO_INFERENCE=true
OPENVINO_INFERENCE_DEVICE=CPU
PADIM_INFERENCE_ACCELERATOR=auto
BASELINE_THRESHOLD=1.34
OPENCV_NUM_THREADS=2
WARM_MODEL_ON_STARTUP=true
ANOMALY_MODEL_CACHE_SIZE=2
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=10
REQUEST_LOGGING_ENABLED=true
SECURITY_HEADERS_ENABLED=true

# Development-only bootstrap account. It is never created in production.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@visioninspect.ai
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_NAME=VisionInspect Admin

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
