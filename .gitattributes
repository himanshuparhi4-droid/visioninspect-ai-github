# Auto detect text files and perform LF normalization
* text=auto

# Preserve trained model artifacts byte-for-byte across platforms.
*.onnx binary
*.npz binary
*.pkl binary
*.pth binary

# Store deployable OpenVINO weights outside the regular Git object pack.
models/exported/cable/weights/openvino/model.bin filter=lfs diff=lfs merge=lfs -text
